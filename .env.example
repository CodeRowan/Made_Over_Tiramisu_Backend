# Copy this file to .env and fill in real values.
# Never commit the real .env file — it's already in .gitignore.

# ── Server ───────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# URL of the frontend app, used for CORS and for building links in emails
# (e.g. the password-reset link). Use your deployed URL in production.
FRONTEND_URL=http://localhost:5173

# ── MongoDB ──────────────────────────────────────────────
# MongoDB Atlas connection string (see chat for step-by-step setup).
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbName>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mad-over-tiramisu?retryWrites=true&w=majority

# ── Auth (JWT) ───────────────────────────────────────────
# Any long random string — e.g. generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE=24h

# ── Cloudinary (image hosting) ──────────────────────────
# From your Cloudinary dashboard: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── Email (Nodemailer) ───────────────────────────────────
# Used for password-reset emails and contact-form notifications.
# For Gmail: enable 2FA on the account, then create an "App Password"
# at https://myaccount.google.com/apppasswords — use that here, not your
# normal Gmail password.
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# ── Uploads ──────────────────────────────────────────────
# Temp directory multer writes uploaded files to before pushing to
# Cloudinary. Defaults to /tmp if unset — usually fine to leave unset.
UPLOAD_DIR=/tmp
